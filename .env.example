# Journaly — deployment environment (server-side).
# Copy to .env and fill in real secrets. NEVER commit the real .env.
# The real .env is git-ignored and lives only on the server.

# ── Domains ────────────────────────────────────────────────────────────────
# FRONTEND_DOMAIN / API_DOMAIN: space-separated hostnames Caddy will terminate
# TLS for (sslip.io fallback + real domain can both be listed at once so
# nothing breaks mid-cutover). CANONICAL_API_DOMAIN is the single hostname
# baked into the frontend build as VITE_API_URL — must be one of API_DOMAIN's
# hostnames.
FRONTEND_DOMAIN=129-225-91-43.sslip.io journaly.uz www.journaly.uz
API_DOMAIN=api.129-225-91-43.sslip.io api.journaly.uz
CANONICAL_API_DOMAIN=api.journaly.uz

# ── Django ───────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.129-225-91-43.sslip.io,129-225-91-43.sslip.io,129.225.91.43,localhost,127.0.0.1
# Origins allowed to send unsafe (POST/PUT) requests — admin login, etc.
CSRF_TRUSTED_ORIGINS=https://129-225-91-43.sslip.io,https://api.129-225-91-43.sslip.io
# The SPA calls the API cross-origin:
CORS_ALLOWED_ORIGINS=https://129-225-91-43.sslip.io,https://api.129-225-91-43.sslip.io,http://localhost:5173

# ── Database (dockerised PostgreSQL 16) ──────────────────────────────────
POSTGRES_DB=academyjournal
POSTGRES_USER=academy_app
POSTGRES_PASSWORD=change-me
# Django reads this; host "db" is the compose service name.
DATABASE_URL=postgres://academy_app:change-me@db:5432/academyjournal

# ── Telegram bot / Web Push ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot username WITHOUT the leading @ — used to build t.me/<name> deep links.
TELEGRAM_BOT_USERNAME=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@journaly.uz
